@implements IDisposable
@inject IAudioConverterService AudioConverterService
@inject IFileDialogService FileDialogs
@inject IStringLocalizer<AppResources> Localizer
@inject LanguageService Language

<section class="panel">
    <h1 class="panel-title">@Localizer["AudioConverterTitle"]</h1>

    <div class="field">
        <span class="field-label">@Localizer["AudioSourceLabel"]</span>
        <div class="field-row">
            <button type="button"
                    class="secondary-button"
                    disabled="@_isConverting"
                    @onclick="SelectSourceAsync">
                @Localizer["AudioSelectFileButton"]
            </button>
            <span class="field-value">@SourceDisplayName</span>
        </div>
    </div>

    @if (_sourceFormat is not null && _targetFormat is not null)
    {
        <div class="field">
            <span class="field-label">@Localizer["AudioSourceFormatLabel"]</span>
            <span class="field-value">@FormatName(_sourceFormat.Value)</span>
        </div>

        <div class="field">
            <span class="field-label">@Localizer["AudioTargetFormatLabel"]</span>
            <div class="format-options">
                @foreach (var format in AudioFileSupport.Formats)
                {
                    <button type="button"
                            class="format-option @TargetFormatClass(format)"
                            disabled="@_isConverting"
                            @onclick="() => SelectTargetFormat(format)">
                        @FormatName(format)
                    </button>
                }
            </div>
            @if (_targetFormat == _sourceFormat)
            {
                <p class="field-error">@Localizer["AudioSameFormatError"]</p>
            }
        </div>

        <div class="field">
            <span class="field-label">@Localizer["AudioOutputPathLabel"]</span>
            <span class="field-value">@_outputPath</span>
        </div>

        @if (_progress is not null)
        {
            <div class="operation-status">
                <p class="operation-stage">@Localizer.DescribeStage(_progress.Stage)</p>
                <div class="progress-track">
                    <div class="progress-fill" style="width:@(PercentageText)%"></div>
                </div>
                <p class="operation-percentage">@(PercentageText)%</p>
            </div>
        }

        <div class="actions">
            <button type="button"
                    class="primary-button"
                    disabled="@(!CanConvert)"
                    @onclick="ConvertAsync">
                @Localizer["AudioConvertButton"]
            </button>
            @if (_isConverting && !_confirmingCancel)
            {
                <button type="button" class="secondary-button" @onclick="RequestCancel">
                    @Localizer["AudioCancelButton"]
                </button>
            }
        </div>

        @if (_confirmingCancel)
        {
            <div class="cancel-confirm">
                <p class="cancel-confirm-message">@Localizer["AudioCancelConfirmMessage"]</p>
                <div class="actions">
                    <button type="button" class="secondary-button" @onclick="ConfirmCancel">
                        @Localizer["AudioCancelConfirmYes"]
                    </button>
                    <button type="button" class="primary-button" @onclick="DismissCancel">
                        @Localizer["AudioCancelConfirmNo"]
                    </button>
                </div>
            </div>
        }

        @if (_completedOutputPath is not null)
        {
            <div class="operation-success">
                <p class="operation-success-message">@Localizer["AudioSuccessMessage"]</p>
                <p class="operation-path">@_completedOutputPath</p>
            </div>
        }

        @if (_errorCode is not null)
        {
            <p class="field-error operation-error">@Localizer.DescribeErrorCode(_errorCode.Value)</p>
        }
    }
</section>

@code {
    private string? _sourcePath;
    private AudioFormat? _sourceFormat;
    private AudioFormat? _targetFormat;
    private string? _outputPath;
    private string? _completedOutputPath;
    private ProgressInfo? _progress;
    private ErrorCode? _errorCode;
    private CancellationTokenSource? _cancellation;
    private bool _isConverting;
    private bool _confirmingCancel;
    private bool _disposed;

    private string SourceDisplayName =>
        string.IsNullOrEmpty(_sourcePath) ? Localizer["AudioNoFileSelected"] : _sourcePath;

    private string PercentageText =>
        Math.Clamp(_progress?.Percentage ?? 0, 0, 100).ToString("0", CultureInfo.InvariantCulture);

    private bool CanConvert =>
        !_isConverting
        && _sourcePath is not null
        && _targetFormat is not null
        && _targetFormat != _sourceFormat
        && _outputPath is not null;

    protected override void OnInitialized()
    {
        Language.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private string FormatName(AudioFormat format) => format switch
    {
        AudioFormat.M4A => Localizer["FormatNameM4A"],
        AudioFormat.MP3 => Localizer["FormatNameMP3"],
        _ => format.ToString(),
    };

    private string TargetFormatClass(AudioFormat format) =>
        _targetFormat == format ? "format-option-active" : string.Empty;

    private async Task SelectSourceAsync()
    {
        string? path;
        try
        {
            path = await FileDialogs.PickFileAsync(
                Localizer["AudioFileDialogTitle"],
                Localizer["AudioFileDialogFilter"]);
        }
        catch (Exception)
        {
            _errorCode = ErrorCode.Unknown;
            return;
        }

        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        if (!AudioFileSupport.TryDetectFormat(path, out var format))
        {
            _errorCode = ErrorCode.UnsupportedFormat;
            return;
        }

        _sourcePath = path;
        _sourceFormat = format;

        // Default to the opposite format so the most common conversion needs no extra click.
        var target = format == AudioFormat.M4A ? AudioFormat.MP3 : AudioFormat.M4A;
        _targetFormat = target;
        _outputPath = AudioFileSupport.BuildTargetPath(path, target);

        ResetResult();
    }

    private void SelectTargetFormat(AudioFormat format)
    {
        _targetFormat = format;

        if (_sourcePath is not null)
        {
            _outputPath = AudioFileSupport.BuildTargetPath(_sourcePath, format);
        }

        ResetResult();
    }

    private async Task ConvertAsync()
    {
        if (!CanConvert)
        {
            return;
        }

        ResetResult();
        _isConverting = true;
        _confirmingCancel = false;
        _progress = new ProgressInfo(0, ProgressStage.Starting);
        _cancellation = new CancellationTokenSource();
        StateHasChanged();

        var sourcePath = _sourcePath!;
        var outputPath = _outputPath!;
        var targetFormat = _targetFormat!.Value;
        var cancellation = _cancellation;

        // Progress callbacks arrive on a background thread, so InvokeAsync marshals the re-render
        // back onto the Blazor renderer thread.
        var progress = new Progress<ProgressInfo>(info =>
        {
            if (_disposed)
            {
                return;
            }

            _progress = info;
            _ = InvokeAsync(StateHasChanged);
        });

        OperationResult result;
        try
        {
            result = await AudioConverterService.ConvertAsync(
                sourcePath,
                outputPath,
                targetFormat,
                progress,
                cancellation.Token);
        }
        catch (Exception)
        {
            result = OperationResult.Fail(ErrorCode.Unknown);
        }

        if (_disposed)
        {
            return;
        }

        cancellation.Dispose();
        _cancellation = null;
        _isConverting = false;
        _confirmingCancel = false;

        if (result.Succeeded)
        {
            _progress = new ProgressInfo(100, ProgressStage.Completed);
            _completedOutputPath = outputPath;
        }
        else
        {
            _progress = null;
            _errorCode = result.ErrorCode ?? ErrorCode.Unknown;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RequestCancel() => _confirmingCancel = true;

    private void DismissCancel() => _confirmingCancel = false;

    private void ConfirmCancel()
    {
        _confirmingCancel = false;
        _cancellation?.Cancel();
    }

    private void ResetResult()
    {
        _completedOutputPath = null;
        _errorCode = null;
        _progress = null;
    }

    public void Dispose()
    {
        _disposed = true;
        Language.LanguageChanged -= OnLanguageChanged;
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
