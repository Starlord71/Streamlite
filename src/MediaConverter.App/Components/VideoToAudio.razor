@implements IDisposable
@inject IAudioConverterService AudioConverterService
@inject IFileDialogService FileDialogs
@inject IStringLocalizer<AppResources> Localizer
@inject LanguageService Language
@inject OperationCoordinator Operations

<section class="panel">
    <h1 class="panel-title">@Localizer["VideoToAudioTitle"]</h1>
    <p class="panel-hint">@Localizer["VideoToAudioPanelHint"]</p>

    <div class="field">
        <span class="field-label">@Localizer["VideoToAudioSourceLabel"]</span>
        <div class="field-row">
            <button type="button"
                    class="secondary-button"
                    disabled="@Operations.IsBusy"
                    @onclick="SelectSourceAsync">
                @Localizer["VideoToAudioSelectFileButton"]
            </button>
            <PathDisplay Path="@_sourcePath" EmptyText="@Localizer["VideoToAudioNoFileSelected"]" />
        </div>
    </div>

    @if (_sourcePath is null && _errorCode is null && !_wasCancelled)
    {
        <p class="empty-state">@Localizer["VideoToAudioEmptyState"]</p>
    }

    @if (_sourcePath is not null && _outputPath is not null)
    {
        <div class="field">
            <span class="field-label">@Localizer["VideoToAudioTargetFormatLabel"]</span>
            <div class="format-options">
                @foreach (var format in AudioFileSupport.Formats)
                {
                    <button type="button"
                            class="format-option @TargetFormatClass(format)"
                            disabled="@Operations.IsBusy"
                            @onclick="() => SelectTargetFormat(format)">
                        @FormatName(format)
                    </button>
                }
            </div>
        </div>

        <div class="field">
            <span class="field-label">@Localizer["VideoToAudioOutputPathLabel"]</span>
            <PathDisplay Path="@_outputPath" />
        </div>

        @if (_progress is not null)
        {
            <div class="operation-status">
                <p class="operation-stage">@Localizer.DescribeStage(_progress.Stage)</p>
                <div class="progress-track">
                    <div class="progress-fill" style="width:@(PercentageText)%"></div>
                </div>
                <p class="operation-percentage">@(PercentageText)%</p>
            </div>
        }

        <div class="actions">
            <button type="button"
                    class="primary-button"
                    disabled="@(!CanExtract)"
                    @onclick="ExtractAsync">
                @Localizer["VideoToAudioConvertButton"]
            </button>
            @if (_isExtracting && !_confirmingCancel)
            {
                <button type="button" class="secondary-button" @onclick="RequestCancel">
                    @Localizer["VideoToAudioCancelButton"]
                </button>
            }
        </div>

        @if (_confirmingCancel)
        {
            <div class="cancel-confirm">
                <p class="cancel-confirm-message">@Localizer["VideoToAudioCancelConfirmMessage"]</p>
                <div class="actions">
                    <button type="button" class="secondary-button" @onclick="ConfirmCancel">
                        @Localizer["VideoToAudioCancelConfirmYes"]
                    </button>
                    <button type="button" class="primary-button" @onclick="DismissCancel">
                        @Localizer["VideoToAudioCancelConfirmNo"]
                    </button>
                </div>
            </div>
        }
    }

    @if (_completedOutputPath is not null)
    {
        <div class="operation-success">
            <p class="operation-success-message">@Localizer["VideoToAudioSuccessMessage"]</p>
            <div class="operation-path"><PathDisplay Path="@_completedOutputPath" /></div>
        </div>
    }

    @if (_wasCancelled)
    {
        <p class="operation-cancelled">@Localizer.DescribeErrorCode(ErrorCode.Cancelled)</p>
    }

    @if (_errorCode is not null)
    {
        <p class="field-error operation-error">@Localizer.DescribeErrorCode(_errorCode.Value)</p>
    }
</section>

@code {
    private string? _sourcePath;
    private AudioFormat _targetFormat = AudioFormat.MP3;
    private string? _outputPath;
    private string? _completedOutputPath;
    private ProgressInfo? _progress;
    private ErrorCode? _errorCode;
    private CancellationTokenSource? _cancellation;
    private bool _isExtracting;
    private bool _confirmingCancel;
    private bool _wasCancelled;
    private bool _disposed;

    private string PercentageText =>
        Math.Clamp(_progress?.Percentage ?? 0, 0, 100).ToString("0", CultureInfo.InvariantCulture);

    private bool CanExtract =>
        !Operations.IsBusy
        && _sourcePath is not null
        && _outputPath is not null;

    private string TargetFormatClass(AudioFormat format) =>
        _targetFormat == format ? "format-option-active" : string.Empty;

    private string FormatName(AudioFormat format) => format switch
    {
        AudioFormat.M4A => Localizer["FormatNameM4A"],
        AudioFormat.MP3 => Localizer["FormatNameMP3"],
        _ => format.ToString(),
    };

    protected override void OnInitialized()
    {
        Language.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SelectSourceAsync()
    {
        string? path;
        try
        {
            path = await FileDialogs.PickFileAsync(
                Localizer["VideoToAudioFileDialogTitle"],
                Localizer["VideoToAudioFileDialogFilter"]);
        }
        catch (Exception)
        {
            _errorCode = ErrorCode.Unknown;
            return;
        }

        // A cancelled picker returns null: keep the current selection and show nothing.
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        if (!VideoFileSupport.IsSupportedVideoSource(path))
        {
            // Clear any previous selection so the invalid file cannot be extracted by mistake. The
            // error is rendered outside the selection block, so it is always visible.
            _sourcePath = null;
            _outputPath = null;
            ResetResult();
            _errorCode = ErrorCode.UnsupportedFormat;
            return;
        }

        _sourcePath = path;

        // MP3 stays the default so the most common extraction needs no extra click. The output
        // always sits next to the source and uses the shared non-colliding naming helper, so an
        // existing file is never overwritten.
        _targetFormat = AudioFormat.MP3;
        _outputPath = AudioFileSupport.BuildTargetPath(path, _targetFormat);
        ResetResult();
    }

    private void SelectTargetFormat(AudioFormat format)
    {
        _targetFormat = format;

        if (_sourcePath is not null)
        {
            _outputPath = AudioFileSupport.BuildTargetPath(_sourcePath, format);
        }

        ResetResult();
    }

    private async Task ExtractAsync()
    {
        if (!CanExtract)
        {
            return;
        }

        ResetResult();
        _isExtracting = true;
        _confirmingCancel = false;
        _progress = new ProgressInfo(0, ProgressStage.Starting);
        _cancellation = new CancellationTokenSource();

        // The coordinator reserves the operation slot before the first await, so a second click
        // cannot start a parallel extraction, and releases it before the final render.
        var operation = Operations.Begin();
        StateHasChanged();

        var sourcePath = _sourcePath!;
        var outputPath = _outputPath!;
        var targetFormat = _targetFormat;
        var cancellation = _cancellation;

        // Progress callbacks arrive on a background thread, so InvokeAsync marshals the re-render
        // back onto the Blazor renderer thread.
        var progress = new Progress<ProgressInfo>(info =>
        {
            if (_disposed)
            {
                return;
            }

            _progress = info;
            _ = InvokeAsync(StateHasChanged);
        });

        OperationResult result;
        try
        {
            // The audio converter discards the video stream with ffmpeg's -vn flag, so an MP4
            // source is handled by the exact same code path as an audio file.
            result = await AudioConverterService.ConvertAsync(
                sourcePath,
                outputPath,
                targetFormat,
                progress,
                cancellation.Token);
        }
        catch (Exception)
        {
            result = OperationResult.Fail(ErrorCode.Unknown);
        }
        finally
        {
            operation.Dispose();
        }

        if (_disposed)
        {
            return;
        }

        cancellation.Dispose();
        _cancellation = null;
        _isExtracting = false;
        _confirmingCancel = false;

        if (result.Succeeded)
        {
            _progress = new ProgressInfo(100, ProgressStage.Completed);
            _completedOutputPath = outputPath;
        }
        else if (result.ErrorCode == ErrorCode.Cancelled)
        {
            // Cancelling is not an error: show a neutral notice and drop the progress bar.
            _progress = null;
            _wasCancelled = true;
        }
        else
        {
            _progress = null;
            _errorCode = result.ErrorCode ?? ErrorCode.Unknown;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RequestCancel() => _confirmingCancel = true;

    private void DismissCancel() => _confirmingCancel = false;

    private void ConfirmCancel()
    {
        _confirmingCancel = false;
        _cancellation?.Cancel();
    }

    private void ResetResult()
    {
        _completedOutputPath = null;
        _errorCode = null;
        _wasCancelled = false;
        _progress = null;
    }

    public void Dispose()
    {
        _disposed = true;
        Language.LanguageChanged -= OnLanguageChanged;
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
