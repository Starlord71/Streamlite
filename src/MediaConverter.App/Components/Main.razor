@implements IDisposable
@inject IBinariesProvisioningService ProvisioningService
@inject IStringLocalizer<AppResources> Localizer
@inject LanguageService Language

<div class="app-shell">
    <header class="language-bar">
        <span class="language-label">@Localizer["LanguageLabel"]</span>
        <button type="button"
                class="language-option @ActiveLanguageClass(LanguageService.English)"
                @onclick="() => SelectLanguageAsync(LanguageService.English)">
            @Localizer["LanguageEnglish"]
        </button>
        <button type="button"
                class="language-option @ActiveLanguageClass(LanguageService.Spanish)"
                @onclick="() => SelectLanguageAsync(LanguageService.Spanish)">
            @Localizer["LanguageSpanish"]
        </button>
    </header>

    <main class="app-content">
        @if (_screen == AppScreen.ChooseLanguage)
        {
        <section class="setup language-choice">
            <h1 class="setup-title">@Localizer["LanguageSelectionTitle"]</h1>
            <p class="setup-message">@Localizer["LanguageSelectionMessage"]</p>
            <div class="language-choice-actions">
                <button type="button"
                        class="setup-retry language-choice-button @ActiveLanguageClass(LanguageService.English)"
                        @onclick="() => SelectLanguageAsync(LanguageService.English)">
                    @Localizer["LanguageEnglish"]
                </button>
                <button type="button"
                        class="setup-retry language-choice-button @ActiveLanguageClass(LanguageService.Spanish)"
                        @onclick="() => SelectLanguageAsync(LanguageService.Spanish)">
                    @Localizer["LanguageSpanish"]
                </button>
            </div>
        </section>
    }
    else if (_screen == AppScreen.Preparing)
    {
        <section class="setup">
            <h1 class="setup-title">@Localizer["PreparingTitle"]</h1>
            <p class="setup-stage">@Localizer.DescribeStage(_progress?.Stage)</p>
            <div class="progress-track">
                <div class="progress-fill" style="width:@(PercentageText)%"></div>
            </div>
            <p class="setup-percentage">@(PercentageText)%</p>
        </section>
    }
    else if (_screen == AppScreen.Failed)
    {
        <section class="setup setup-error">
            <h1 class="setup-title">@Localizer["SetupFailedTitle"]</h1>
            <p class="setup-message">@Localizer.DescribeErrorCode(_errorCode ?? ErrorCode.Unknown)</p>
            <button type="button" class="setup-retry" @onclick="RunProvisioningAsync">@Localizer["RetryButton"]</button>
        </section>
    }
    else
    {
        <section class="workspace">
            <nav class="tab-bar">
                <button type="button"
                        class="tab @ActiveTabClass(AppTab.Audio)"
                        @onclick="() => SelectTab(AppTab.Audio)">
                    @Localizer["TabAudio"]
                </button>
                <button type="button"
                        class="tab @ActiveTabClass(AppTab.Video)"
                        @onclick="() => SelectTab(AppTab.Video)">
                    @Localizer["TabVideo"]
                </button>
                <button type="button"
                        class="tab @ActiveTabClass(AppTab.VideoToAudio)"
                        @onclick="() => SelectTab(AppTab.VideoToAudio)">
                    @Localizer["TabVideoToAudio"]
                </button>
            </nav>
            <div class="tab-content">
                @if (_tab == AppTab.Audio)
                {
                    <AudioConverter />
                }
                else if (_tab == AppTab.Video)
                {
                    <VideoDownloader />
                }
                else
                {
                    <p class="coming-soon">@Localizer["FeatureComingSoon"]</p>
                }
            </div>
        </section>
    }
    </main>
</div>

@code {
    private enum AppScreen
    {
        ChooseLanguage,
        Preparing,
        Failed,
        Ready,
    }

    private enum AppTab
    {
        Audio,
        Video,
        VideoToAudio,
    }

    private readonly CancellationTokenSource _cancellation = new();
    private AppScreen _screen;
    private AppTab _tab = AppTab.Audio;
    private ProgressInfo? _progress;
    private ErrorCode? _errorCode;
    private bool _disposed;

    private string PercentageText =>
        Math.Clamp(_progress?.Percentage ?? 0, 0, 100).ToString("0", CultureInfo.InvariantCulture);

    protected override Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;

        // First run: ask for the language before provisioning so the setup screen is already
        // shown in the chosen language. On later runs the saved preference is applied at startup
        // and provisioning can begin immediately.
        if (Language.HasSavedPreference)
        {
            return RunProvisioningAsync();
        }

        _screen = AppScreen.ChooseLanguage;
        return Task.CompletedTask;
    }

    private string ActiveLanguageClass(string languageCode) =>
        Language.CurrentLanguage == languageCode ? "language-option-active" : string.Empty;

    private string ActiveTabClass(AppTab tab) => _tab == tab ? "tab-active" : string.Empty;

    private void SelectTab(AppTab tab) => _tab = tab;

    private async Task SelectLanguageAsync(string languageCode)
    {
        Language.SetLanguage(languageCode);

        if (_screen == AppScreen.ChooseLanguage)
        {
            await RunProvisioningAsync();
        }
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RunProvisioningAsync()
    {
        if (_disposed)
        {
            return;
        }

        _screen = AppScreen.Preparing;
        _errorCode = null;
        _progress = new ProgressInfo(0, ProgressStage.Starting);
        await InvokeAsync(StateHasChanged);

        // Progress callbacks arrive on a background thread, so InvokeAsync marshals the
        // re-render back onto the Blazor renderer thread.
        var progress = new Progress<ProgressInfo>(info =>
        {
            if (_disposed)
            {
                return;
            }

            _progress = info;
            _ = InvokeAsync(StateHasChanged);
        });

        OperationResult result;
        try
        {
            result = await ProvisioningService.ProvisionAsync(progress, _cancellation.Token);
        }
        catch (Exception)
        {
            result = OperationResult.Fail(ErrorCode.Unknown);
        }

        if (_disposed)
        {
            return;
        }

        if (result.Succeeded)
        {
            _screen = AppScreen.Ready;
        }
        else
        {
            _screen = AppScreen.Failed;
            _errorCode = result.ErrorCode ?? ErrorCode.Unknown;
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        Language.LanguageChanged -= OnLanguageChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
