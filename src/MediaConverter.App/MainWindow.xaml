<Window x:Class="MediaConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:controls="clr-namespace:MediaConverter.App.Controls"
        xmlns:components="clr-namespace:MediaConverter.App.Components"
        Height="620"
        Width="960"
        MinHeight="480"
        MinWidth="720">
    <Grid>
        <controls:EmbeddedBlazorWebView x:Name="RootWebView" HostPage="wwwroot\index.html">
            <controls:EmbeddedBlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Main}" />
            </controls:EmbeddedBlazorWebView.RootComponents>
        </controls:EmbeddedBlazorWebView>
    </Grid>
</Window>
